# Anthropic API — required for AI news curation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vercel KV (Redis) — for storing AI-curated news between cron runs
KV_URL=your_vercel_kv_url_here
KV_REST_API_URL=your_vercel_kv_rest_api_url_here
KV_REST_API_TOKEN=your_vercel_kv_rest_api_token_here
KV_REST_API_READ_ONLY_TOKEN=your_vercel_kv_rest_api_read_only_token_here

# Resend API — REQUIRED for all contact forms (chapter application, materials request, shop waitlist)
# Get your key at resend.com → API Keys
# All emails send TO info@lakeforall.org and FROM onboarding@resend.dev until domain is verified.
# After verifying lakeforall.org in Resend dashboard, update FROM_ADDRESS in src/lib/resend.ts
RESEND_API_KEY=your_resend_api_key_here

# Cron job auth secret — set this and pass as Authorization header
CRON_SECRET=your_secure_random_secret_here
